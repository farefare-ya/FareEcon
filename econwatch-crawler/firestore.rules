rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Semua orang boleh baca (ini data publik: berita & sinyal pasar).
    // Tidak ada yang boleh nulis lewat client — penulisan hanya lewat
    // Admin SDK di GitHub Actions, yang otomatis bypass rules ini.
    match /news/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /signals/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /instruments/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /prices/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
